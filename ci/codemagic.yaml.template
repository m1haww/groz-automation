# GROZ iOS CI Pipeline — Codemagic config
#
# Copiază în root-ul repo-ului iOS sub numele `codemagic.yaml`
# Înlocuiește placeholder-ele: {APP_NAME}, {BUNDLE_ID}, {SCHEME}, {ROUTINE_ID}

workflows:
  groz-ios-qa-flow:
    name: GROZ iOS Build + QA Tests
    instance_type: mac_mini_m2
    max_build_duration: 60

    environment:
      groups:
        - groz_credentials # creează în Codemagic dashboard
      vars:
        XCODE_WORKSPACE: "{APP_NAME}.xcworkspace"
        XCODE_SCHEME: "{SCHEME}"
        BUNDLE_ID: "{BUNDLE_ID}"
      xcode: latest
      cocoapods: default

    triggering:
      events:
        - push
        - pull_request
      branch_patterns:
        - pattern: "main"
          include: true
        - pattern: "develop"
          include: true
        - pattern: "feat/*"
          include: true
        - pattern: "fix/*"
          include: true

    scripts:
      - name: Install dependencies
        script: |
          if [ -f "Podfile" ]; then
            pod install
          fi

      - name: Install Maestro
        script: |
          curl -Ls "https://get.maestro.mobile.dev" | bash
          echo 'export PATH="$PATH":"$HOME/.maestro/bin"' >> $CM_ENV

      - name: Build .app for simulator
        script: |
          xcodebuild build-for-testing \
            -workspace "$XCODE_WORKSPACE" \
            -scheme "$XCODE_SCHEME" \
            -configuration Debug \
            -destination 'platform=iOS Simulator,name=iPhone 15 Pro' \
            -derivedDataPath build/

      - name: Boot simulator
        script: |
          xcrun simctl boot "iPhone 15 Pro" || true
          open -a Simulator
          sleep 15

      - name: Install app on simulator
        script: |
          APP_PATH=$(find build/Build/Products/Debug-iphonesimulator -name "*.app" -maxdepth 1 | head -1)
          xcrun simctl install booted "$APP_PATH"

      - name: Run Maestro tests
        script: |
          export PATH="$PATH":"$HOME/.maestro/bin"
          mkdir -p qa-artifacts/screenshots qa-artifacts/logs
          maestro test .maestro/flows/ \
            --format junit \
            --output qa-artifacts/test-results.xml \
            --debug-output qa-artifacts/maestro-debug/ || true

      - name: Collect screenshots
        script: |
          if [ -d "qa-artifacts/maestro-debug" ]; then
            find qa-artifacts/maestro-debug -name "*.png" -exec cp {} qa-artifacts/screenshots/ \;
          fi

      - name: Generate metadata for GROZ QA
        script: |
          cat > qa-artifacts/metadata.json <<EOF
          {
            "build_id": "$CM_BUILD_ID",
            "commit": "$CM_COMMIT",
            "branch": "$CM_BRANCH",
            "pr_number": "$CM_PULL_REQUEST_NUMBER",
            "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
            "workflow": "groz-ios-qa-flow"
          }
          EOF

    artifacts:
      - qa-artifacts/**/*
      - build/Build/Products/**/*.app

    publishing:
      scripts:
        - name: Trigger GROZ QA Tester routine
          script: |
            curl -X POST "https://api.anthropic.com/v1/routines/{ROUTINE_ID}/fire" \
              -H "Authorization: Bearer $ANTHROPIC_ROUTINE_TOKEN" \
              -H "Content-Type: application/json" \
              -d "{
                \"build_id\": \"$CM_BUILD_ID\",
                \"commit\": \"$CM_COMMIT\",
                \"branch\": \"$CM_BRANCH\",
                \"pr_number\": \"$CM_PULL_REQUEST_NUMBER\",
                \"artifacts_url\": \"$CM_BUILD_URL/artifacts\"
              }" || echo "Routine trigger failed (non-fatal)"

      email:
        recipients:
          - normandcarie782@gmail.com
        notify:
          success: false
          failure: true
